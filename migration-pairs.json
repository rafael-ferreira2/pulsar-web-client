        { "path": "fixture.competition.canonicalId.value",                    "severity": "important", "type": "string",             "purpose": "mapping — competition identity",                  "rcpRef": "MappingToCompetitionConverter.java:38" },
        { "path": "fixture.competition.providerIds",                          "severity": "important", "type": "map<string,IdList>", "purpose": "mapping — competition provider IDs",              "rcpRef": "MappingToCompetitionConverter.java:36-37" },
        { "path": "fixture.providerIds",                                      "severity": "critical",  "type": "map<string,StringValue>", "purpose": "mapping — fixture provider IDs (no providers = no mapping output)", "rcpRef": "AbstractFixtureConverter.java:48,71-73" },
        { "path": "fixture.name.value",                                       "severity": "important", "type": "string",             "purpose": "business — used unguarded in football team-name match",  "rcpRef": "FootballConverter.java:75,126,148" },
        { "path": "fixture.startTime.value",                                  "severity": "info",      "type": "string (RFC3339)",   "purpose": "business — fixture kick-off",                     "rcpRef": "FootballConverter.java:62-64" },
        { "path": "fixture.teams[]",                                          "severity": "critical",  "type": "repeated message",   "purpose": "business — team list (mapping fails without it for football)", "rcpRef": "FootballConverter.java:77" },
        { "path": "fixture.teams[].name.value",                               "severity": "important", "type": "string",             "purpose": "business — team-name matching",                   "rcpRef": "FootballConverter.java:90-91 / TeamDistanceMatchEngine.java:10" },
        { "path": "fixture.teams[].providerIds",                              "severity": "important", "type": "map<string,StringValue>", "purpose": "mapping — team-side provider IDs",          "rcpRef": "FootballTeamConverter.java:36-37" },
        { "path": "fixture.teams[].players[]",                                "severity": "info",      "type": "repeated message",   "purpose": "business — player roster (optional)",             "rcpRef": "FootballTeamConverter.java:51" },
        { "path": "fixture.teams[].players[].name.value",                     "severity": "info",      "type": "string",             "purpose": "business — player-name match",                    "rcpRef": "FootballPlayerConverter.java:33" },
        { "path": "fixture.teams[].players[].matchName.value",                "severity": "info",      "type": "string",             "purpose": "business — fallback match name",                  "rcpRef": "FootballPlayerConverter.java:47-48" },
        { "path": "fixture.teams[].players[].providerIds",                    "severity": "info",      "type": "map",                "purpose": "mapping — player provider IDs",                   "rcpRef": "FootballPlayerConverter.java:29-30" },

        { "path": "competition",                                              "severity": "important", "type": "message (oneof)",    "purpose": "routing — top-level competition entity branch",   "rcpRef": "EventDrivenMessageListener.java" },
        { "path": "competition.sport",                                        "severity": "critical",  "type": "enum",               "purpose": "routing — required for competition mapping",      "rcpRef": "MappingToCompetitionConverter.java:29" },
