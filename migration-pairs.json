    {
      "id": "live-mappings",
      "name": "Live ID/RAMP mappings",
      "description": "Sportsbook↔provider ID mapping events (MappingOuterClass.Mapping protobuf with a oneof entity discriminator). RCP routes each message to a converter (Fixture / Competition / Meeting / Race) based on which branch is populated.",
      "domain": "livedata.mappings",
      "consumer": "rcp-service",
      "consumerNotes": "Hot path: EventDrivenMessageListener (providers/mapping) → MappingDeserializer.parseFrom(MappingOuterClass.Mapping) → branch-specific converters (FixtureConverter / MappingToCompetitionConverter / MappingToMeetingConverter / MappingToRaceConverter). Football branch additionally walks FootballConverter / FootballTeamConverter / FootballPlayerConverter.",
      "endpoints": {
        "kafka":  { "topicIdContains": "livedata_mappings", "topicPathContains": "livedata.mappings" },
        "pulsar": { "topicIdContains": "mappings",          "topicPathContains": "livedata-inbound/livedata-mappings" }
      },
      "evaluation": { "minMessagesPerSide": 3, "presenceMatcher": "any-message" },
      "fields": [
        { "path": "headers",                                                  "severity": "info",      "type": "map<string,string>", "purpose": "tracing / RcpContext header propagation", "rcpRef": "EventDrivenMessageListener.java:110" },

        { "path": "fixture",                                                  "severity": "important", "type": "message (oneof)",    "purpose": "routing — at least one entity branch must populate per message; this is the fixture branch", "rcpRef": "EventDrivenMessageListener.java:96-108" },
        { "path": "fixture.canonicalId.value",                                "severity": "critical",  "type": "string",             "purpose": "identity — primary key for the fixture mapping",  "rcpRef": "AbstractFixtureConverter.java:38,78" },
